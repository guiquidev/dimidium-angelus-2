[connection signal="action_executed" from="Rooms/Combat/Entities/Player" to="Rooms/Combat" method="execute_action"]
[connection signal="health_changed" from="Rooms/Combat/Entities/Player" to="Camera2D" method="_on_player_health_changed"]
[connection signal="health_changed" from="Rooms/Combat/Entities/Player" to="GameUI/BottomSection/MarginContainerBottom/Bottom/PlayerStatus/MarginContainer/PlayerUIManager" method="on_health_changed"]
[connection signal="mana_changed" from="Rooms/Combat/Entities/Player" to="GameUI/BottomSection/MarginContainerBottom/Bottom/PlayerStatus/MarginContainer/PlayerUIManager" method="on_mana_changed"]
[connection signal="action_executed" from="Rooms/Combat/Entities/Enemy" to="Rooms/Combat" method="execute_action"]
[connection signal="pressed" from="GameUI/BonfireUI/Panel/MarginContainer/VBoxContainer/HealButton" to="Rooms/Bonfire" method="_on_button_pressed"]
[connection signal="pressed" from="GameUI/BottomSection/MarginContainerContinue/ContinueButton" to="Rooms" method="_on_continue_button_pressed"]
[connection signal="pressed" from="GameUI/BottomSection/MarginContainerBottom/Bottom/Details/MarginContainer/VBoxContainer/EndTurnButton" to="Rooms/Combat" method="_on_end_turn_button_pressed"]
[connection signal="pressed" from="TitleScreen/HBoxContainer/MarginContainerLeft/VBoxContainer/PlayButton" to="." method="start_game"]
[connection signal="pressed" from="WinScreen/MarginContainer/VBoxContainer/MarginContainer/ReplayButton" to="." method="restart_game"]
[connection signal="pressed" from="LoseScreen/MarginContainer/VBoxContainer/MarginContainer/ReplayButton" to="." method="restart_game"]
